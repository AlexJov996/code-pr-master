diff --git a/src/server/invitations/invitationService.ts b/src/server/invitations/invitationService.ts
new file mode 100644
--- /dev/null
+++ b/src/server/invitations/invitationService.ts
@@ -0,0 +1,30 @@
+import { randomBytes } from "node:crypto"
+import { db } from "../db"
+import { sendInvitationEmail } from "../email/invitation"
+
+const SEVEN_DAYS = 7 * 24 * 60 * 60 * 1000
+
+export async function createInvitation(orgId: string, email: string, role: Role) {
+  const token = randomBytes(24).toString("hex")
+  const expiresAt = new Date(Date.now() + SEVEN_DAYS)
+  const invitation = await db.invitation.create({ data: { orgId, email, role, token, expiresAt } })
+  await sendInvitationEmail(email, token)
+  return invitation
+}
+
+export async function listInvitations(orgId: string) {
+  return db.invitation.findMany({ where: { orgId } })
+}
+
+export async function acceptInvitation(token: string, userId: string) {
+  const invitation = await db.invitation.findUnique({ where: { token } })
+  if (!invitation || invitation.expiresAt < new Date()) throw new Error("Invitation expired")
+  await db.member.create({ data: { orgId: invitation.orgId, userId, role: invitation.role } })
+  await db.invitation.delete({ where: { id: invitation.id } })
+}
+
+class InvitationError extends Error {}
+
+function isExpired(expiresAt: Date) {
+  return expiresAt < new Date()
+}
diff --git a/src/server/invitations/invitationRouter.ts b/src/server/invitations/invitationRouter.ts
new file mode 100644
--- /dev/null
+++ b/src/server/invitations/invitationRouter.ts
@@ -0,0 +1,12 @@
+import { Router } from "express"
+import { canInviteMembers } from "../auth/permissions"
+import { createInvitation, listInvitations, acceptInvitation } from "./invitationService"
+
+export const invitationRouter = Router()
+
+invitationRouter.post("/", async (req, res) => {
+  if (!canInviteMembers(req.member)) return res.status(403).end()
+  res.json(await createInvitation(req.member.orgId, req.body.email, req.body.role))
+})
+invitationRouter.get("/", async (req, res) => res.json(await listInvitations(req.member.orgId)))
+invitationRouter.post("/accept", async (req, res) => res.json(await acceptInvitation(req.body.token, req.user.id)))
